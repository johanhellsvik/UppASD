simid bccAFM00
ncell     10        10       10                 System size
BC        P         P         P                 Boundary conditions (0=vacuum, P=periodic)
cell      1.00000   0.00000   0.00000
          0.00000   1.00000   0.00000
          0.00000   0.00000   1.00000
Sym       1                                     Symmetry of lattice (0 for no, 1 for cubic, 2 for 2d cubic, 3 for hexagonal)
do_prnstruct 0

posfile    ./posfile
momfile    ./momfile
exchange   ./jfile
anisotropy ./kfile

SDEalgh   1                                     SDE solver: 1=midpoint, 2=heun, 3=heun3, 4=Heun_proper, 5=Depondt
Initmag   3                                     Initial config of moments (1=random, 2=cone, 3=spec., 4=file)

mode      S
Temp      001.00          K                     Temperature of the system

damping   0.01                                  damping parameter (gamma)
nstep     100000                                Number of time-steps
timestep  1.000e-17       s                     The time step-size for the SDE-solver

do_avrg   Y                                     Measure averages
do_proj_avrg A
plotenergy 1

do_sc C
do_ams Y
do_magdos Y
magdos_freq 200
magdos_sigma 30
qpoints C

do_stiffness Y
eta_max 12
eta_min 6
alat 2.83e-10
